    "api:matrix": "node scripts/api-maintenance.mjs matrix",
    "verify": "npm test && npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "pack:mcpb": "bash scripts/pack-mcpb.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chrono-node": "^2.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
