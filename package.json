{
  "name": "weeek-mcp-andrey",
  "version": "0.5.0",
  "private": true,
  "description": "Maintained local WEEEK MCP fork: verified task and CRM workflows",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "weeek",
    "claude",
    "task-tracker",
    "productivity"
  ],
  "license": "MIT",
  "author": "Ilya Ivanchikov <ilyaivanchikov96@mail.ru> (https://www.linkedin.com/in/ilyaivanchikov)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitcony/weeek-mcp-andrey.git"
  },
  "homepage": "https://github.com/bitcony/weeek-mcp-andrey#readme",
  "bugs": {
    "url": "https://github.com/bitcony/weeek-mcp-andrey/issues"
  },
  "type": "module",
  "bin": {
    "weeek-mcp-smart": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "node scripts/live-acceptance.mjs",
